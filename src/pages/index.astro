---
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import Container from '../components/core/Container.astro';
import FeatureCard from '../components/cards/FeatureCard.astro';
---

<Layout>
  <HomeHeroSection />
    
    <!-- 公司页面区域 -->
  <Container>
    <section class="feature-card section">
      <h2>Company Pages</h2>
      <p>
        Use one of our prebuilt company pages for your about page, contact page,
        legal pages, blog posts, etc.
      </p>
       <div class="feature-card grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
        <FeatureCard href="/company/about" title="About Us" imgSrc="/images/company/about.jpg" />
        <FeatureCard href="/company/contact" title="Contact Us" imgSrc="/images/company/contact.jpg" />
        <FeatureCard href="/blog/" title="Blog" imgSrc="/images/company/blog.jpg" />
        <FeatureCard
          href="/blog/posts/remote-work-mental-health"
          title="Blog Post"
          imgSrc="/images/company/blog-post.jpg"
        />
      </div>
    </section>
  </Container>
  
</Layout>